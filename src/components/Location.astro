---
const mapsLink = 'https://maps.google.com/?q=Corso+Nizza+92+Cuneo';
const osmEmbedSrc =
  'https://www.openstreetmap.org/export/embed.html?bbox=7.5318%2C44.3858%2C7.5472%2C44.3918&layer=mapnik&marker=44.3888%2C7.5395';
---
<section id="dove" aria-labelledby="location-title">
  <div class="container">
    <div class="loc-header">
      <p class="section-label reveal">Come raggiungerci</p>
      <h2 class="section-title reveal d1" id="location-title">
        Siamo nel cuore di <span>Cuneo</span>
      </h2>
      <div class="gold-line reveal d2"></div>
    </div>

    <div class="map-stage">
      <iframe
        title="Mappa Ristorante Cielo Azzurro Cuneo"
        src={osmEmbedSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
        aria-label="Posizione del ristorante su mappa interattiva"
      ></iframe>
      <a
        href={mapsLink}
        target="_blank"
        rel="noopener noreferrer"
        class="map-open-link"
        aria-label="Apri su Google Maps in una nuova scheda"
      >
        Apri in Google Maps ↗
      </a>
    </div>

    <div class="loc-details">
      <div class="info-item reveal d1">
        <span class="info-icon" aria-hidden="true">📍</span>
        <div>
          <p class="info-label">Indirizzo</p>
          <p class="info-val">Corso Nizza, 92</p>
          <p class="info-sub">12100 Cuneo (CN) · Piemonte</p>
        </div>
      </div>
      <div class="info-item reveal d2">
        <span class="info-icon" aria-hidden="true">🚗</span>
        <div>
          <p class="info-label">In auto</p>
          <p class="info-val">Parcheggio disponibile nelle vicinanze</p>
          <p class="info-sub">Corso Nizza è facilmente raggiungibile dal centro</p>
        </div>
      </div>
      <div class="info-item reveal d3">
        <span class="info-icon" aria-hidden="true">🚌</span>
        <div>
          <p class="info-label">Con i mezzi</p>
          <p class="info-val">Fermata autobus nelle vicinanze</p>
          <p class="info-sub">Servito dalle linee urbane di Cuneo</p>
        </div>
      </div>
    </div>

    <div class="loc-ctas reveal d3">
      <a
        href={mapsLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
        aria-label="Apri indicazioni su Google Maps (nuova scheda)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5S10.6 6.5 12 6.5s2.5 1.1 2.5 2.5S13.4 11.5 12 11.5z"/>
        </svg>
        Indicazioni su Maps
      </a>
      <a href="tel:+393394195587" class="btn btn-outline">📞 Chiama</a>
    </div>
  </div>
</section>

<style>
  #dove {
    background: var(--bg);
  }

  .loc-header {
    max-width: 560px;
    margin-bottom: 40px;
  }

  .map-stage {
    position: relative;
    width: 100%;
    height: clamp(380px, 58vw, 620px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #e8e8e8;
    margin-bottom: 32px;
  }

  .map-stage iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map-open-link {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.82);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .map-open-link:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: #ffffff;
  }

  .loc-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 32px;
  }

  .info-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .info-icon {
    font-size: 1.3rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gold-dim);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .info-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 3px;
  }

  .info-val {
    font-size: 0.97rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 2px;
  }

  .info-sub {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .loc-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .map-stage {
      height: clamp(320px, 72vw, 460px);
    }

    .loc-details {
      grid-template-columns: 1fr;
    }
  }
</style>
