---
const links = [
  { href: '/#chi-siamo', label: 'Chi siamo' },
  { href: '/menu',       label: 'Menu' },
  { href: '/#ayce',      label: 'All You Can Eat' },
  { href: '/#orari',     label: 'Orari' },
  { href: '/#dove',      label: 'Dove siamo' },
];
---
<nav id="main-nav" aria-label="Navigazione principale">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Cielo Azzurro - Home">
      <span class="logo-zh">天藍</span>
      <span class="logo-stack">
        <span class="logo-text">Cielo Azzurro</span>
        <span class="logo-tagline">Cucina giapponese e cinese</span>
      </span>
    </a>

    <ul class="nav-links" role="list">
      {links.map(l => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>

    <a href="tel:+393394195587" class="btn btn-primary nav-cta" aria-label="Chiama il ristorante">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
      Prenota
    </a>

    <button id="burger" class="burger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" role="dialog" aria-label="Menu mobile" aria-modal="true">
    <div class="mobile-menu-panel">
      <button id="mobile-menu-close" class="mobile-menu-close" aria-label="Chiudi menu">Chiudi ✕</button>
      <ul role="list" class="mobile-menu-links">
        {links.map(l => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
      <a href="tel:+393394195587" class="btn btn-primary mobile-menu-cta" aria-label="Chiama per prenotare un tavolo">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        Prenota un Tavolo
      </a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 16px 24px;
    background: #000000;
    transition: background .35s ease, padding .35s ease, box-shadow .35s ease;
  }

  nav:hover {
    background: #0a0a0a;
    box-shadow: 0 4px 24px rgba(196, 30, 58, 0.18);
  }

  nav.scrolled {
    background: #000000;
    padding: 10px 24px;
    box-shadow: 0 1px 0 rgba(196, 30, 58, 0.35);
  }

  nav.scrolled:hover {
    background: #0d0d0d;
    box-shadow: 0 4px 28px rgba(196, 30, 58, 0.22);
  }

  .nav-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .logo-stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .logo-zh {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    color: var(--gold);
    border: 1.5px solid var(--border);
    padding: 3px 7px;
    border-radius: 4px;
    letter-spacing: .05em;
    align-self: flex-start;
  }

  .logo-text {
    font-family: 'Cinzel', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: .06em;
    line-height: 1.2;
    transition: color .25s;
  }

  .nav-logo:hover .logo-text {
    color: var(--gold-lt);
  }

  .logo-tagline {
    font-family: 'Lato', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.2;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 4px;
    margin-left: auto;
  }
  .nav-links a {
    font-size: .88rem;
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--gold);
    padding: 8px 14px;
    border-radius: 6px;
    transition: color .25s, background .25s;
  }

  .nav-links a:hover {
    color: #ffffff;
    background: var(--gold);
  }

  .nav-cta {
    font-size: .82rem;
    padding: 10px 22px;
    background: transparent;
    color: var(--gold);
    border: 1.5px solid var(--gold);
  }

  .nav-cta:hover {
    background: var(--gold);
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(196, 30, 58, 0.35);
  }

  /* Burger */
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    margin-left: auto;
  }
  .burger span {
    display: block;
    width: 24px; height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transition: var(--trans);
  }
  .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu — fullscreen */
  #mobile-menu {
    visibility: hidden;
    pointer-events: none;
    position: fixed;
    inset: 0;
    z-index: 1200;
    opacity: 0;
    transition: opacity .3s ease, visibility .3s ease;
  }
  #mobile-menu.open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    overscroll-behavior: none;
  }

  .mobile-menu-panel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    padding: max(20px, env(safe-area-inset-top)) 24px max(32px, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    transform: translateY(12px);
    transition: transform .32s cubic-bezier(.4,0,.2,1);
  }
  #mobile-menu.open .mobile-menu-panel { transform: translateY(0); }

  .mobile-menu-close {
    align-self: flex-end;
    background: transparent;
    border: 1px solid var(--gold);
    color: var(--gold);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    margin-bottom: 40px;
    flex-shrink: 0;
    transition: background .25s, color .25s;
  }

  .mobile-menu-close:hover {
    border-color: var(--gold);
    color: #ffffff;
    background: var(--gold);
  }

  .mobile-menu-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    justify-content: center;
    margin: 0;
    padding: 0;
  }
  .mobile-menu-links li {
    opacity: 0;
    transform: translateY(10px);
    animation: none;
  }
  #mobile-menu:not(.open) .mobile-menu-cta {
    opacity: 0;
    transform: translateY(10px);
    animation: none;
  }
  #mobile-menu.open .mobile-menu-links li {
    animation: menu-link-in .4s ease forwards;
  }
  #mobile-menu.open .mobile-menu-links li:nth-child(1) { animation-delay: .06s; }
  #mobile-menu.open .mobile-menu-links li:nth-child(2) { animation-delay: .1s; }
  #mobile-menu.open .mobile-menu-links li:nth-child(3) { animation-delay: .14s; }
  #mobile-menu.open .mobile-menu-links li:nth-child(4) { animation-delay: .18s; }
  #mobile-menu.open .mobile-menu-links li:nth-child(5) { animation-delay: .22s; }

  @keyframes menu-link-in {
    to { opacity: 1; transform: none; }
  }

  .mobile-menu-links a {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.35rem, 5vw, 1.75rem);
    font-weight: 600;
    color: var(--gold);
    padding: 16px 0;
    border-bottom: 1px solid rgba(196, 30, 58, 0.25);
    display: block;
    transition: color .2s, background .2s, padding .2s;
  }

  .mobile-menu-links a:hover {
    color: #ffffff;
    background: rgba(196, 30, 58, 0.15);
    padding-left: 12px;
  }

  .mobile-menu-cta {
    width: 100%;
    justify-content: center;
    margin-top: auto;
    flex-shrink: 0;
    opacity: 0;
    transform: translateY(10px);
  }
  #mobile-menu.open .mobile-menu-cta {
    animation: menu-link-in .4s ease .28s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-panel { transform: none; transition: none; }
    #mobile-menu { transition: none; }
    .mobile-menu-links li,
    .mobile-menu-cta { opacity: 1; transform: none; animation: none; }
  }

  @media (max-width: 900px) {
    nav,
    nav.scrolled,
    nav:hover,
    nav.scrolled:hover {
      background: #000000;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    nav { padding: 12px 14px; }
    nav.scrolled { padding: 8px 14px; }
    .nav-inner { gap: 12px; }
    .logo-zh { font-size: .92rem; padding: 2px 6px; }
    .logo-text { font-size: .86rem; }
    .logo-tagline { font-size: .6rem; }
    .mobile-menu-panel { padding: max(16px, env(safe-area-inset-top)) 20px max(28px, env(safe-area-inset-bottom)); }
    .mobile-menu-close { padding: 7px 12px; font-size: .74rem; margin-bottom: 28px; }
    .nav-links, .nav-cta { display: none; }
    .burger { display: flex; }
  }

  @media (max-width: 420px) {
    .logo-zh { display: none; }
    .logo-text { font-size: .82rem; }
    .logo-tagline { font-size: .58rem; letter-spacing: 0.08em; }
  }
</style>
