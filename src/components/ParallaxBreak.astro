---
---
<section class="parallax-break" aria-hidden="true">
  <div class="parallax-media">
    <img
      src="/images/parallax-cucina.jpg"
      alt=""
      class="parallax-image"
      width="1920"
      height="1080"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="parallax-overlay"></div>
  <p class="parallax-quote">
    <span>Ogni piatto racconta</span>
    <strong>un viaggio in Oriente</strong>
  </p>
</section>

<style>
  .parallax-break {
    position: relative;
    height: clamp(320px, 52vh, 520px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .parallax-media {
    position: absolute;
    inset: -15% 0;
    z-index: 0;
  }

  .parallax-image {
    width: 100%;
    height: 130%;
    object-fit: cover;
    object-position: center;
    will-change: transform;
  }

  .parallax-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgba(10, 10, 10, 0.72), rgba(10, 10, 10, 0.35) 50%, rgba(10, 10, 10, 0.72)),
      linear-gradient(to bottom, rgba(10, 10, 10, 0.2), rgba(10, 10, 10, 0.55));
  }

  .parallax-quote {
    position: relative;
    z-index: 2;
    text-align: center;
    font-family: 'Cinzel', serif;
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    color: var(--cream);
    line-height: 1.4;
    padding: 24px 32px;
    background: rgba(10, 10, 10, 0.35);
    backdrop-filter: blur(12px) saturate(130%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.3);
  }

  .parallax-quote span {
    display: block;
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 8px;
  }

  .parallax-quote strong {
    color: var(--gold);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .parallax-break {
      height: clamp(260px, 42vh, 360px);
    }

    .parallax-quote {
      padding: 20px 24px;
      margin: 0 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax-media {
      inset: 0;
    }

    .parallax-image {
      height: 100%;
      transform: none !important;
    }
  }
</style>

<script>
  const section = document.querySelector('.parallax-break');
  const image = document.querySelector('.parallax-image');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && image && !reducedMotion) {
    let ticking = false;

    const updateParallax = () => {
      const rect = section.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const progress = (rect.top + rect.height * 0.5 - viewportHeight * 0.5) / viewportHeight;
      const offset = progress * -48;
      image.style.transform = `translate3d(0, ${offset}px, 0) scale(1.08)`;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateParallax);
        }
      },
      { passive: true }
    );

    updateParallax();
  }
</script>
