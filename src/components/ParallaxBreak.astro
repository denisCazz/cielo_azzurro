---
---
<section class="parallax-break" aria-hidden="true">
  <div class="parallax-overlay"></div>
  <p class="parallax-quote">
    <span>Ogni piatto racconta</span>
    <strong>un viaggio in Oriente</strong>
  </p>
</section>

<style>
  .parallax-break {
    position: relative;
    height: clamp(280px, 46vh, 460px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('/images/parallax-cucina.webp') center / cover no-repeat scroll;
  }

  @media (min-width: 901px) {
    .parallax-break {
      background-attachment: fixed;
    }
  }

  .parallax-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgba(10, 10, 10, 0.72), rgba(10, 10, 10, 0.35) 50%, rgba(10, 10, 10, 0.72)),
      linear-gradient(to bottom, rgba(10, 10, 10, 0.2), rgba(10, 10, 10, 0.55));
  }

  .parallax-quote {
    position: relative;
    z-index: 2;
    text-align: center;
    font-family: 'Cinzel', serif;
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    color: var(--cream);
    line-height: 1.4;
    padding: 24px 32px;
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.3);
  }

  .parallax-quote span {
    display: block;
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 8px;
  }

  .parallax-quote strong {
    color: var(--gold);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .parallax-break {
      height: clamp(240px, 38vh, 340px);
    }

    .parallax-quote {
      padding: 20px 24px;
      margin: 0 20px;
    }
  }
</style>
